<view class="game-page">
 <view wx:if="{{loading}}" class="loading">小细节就位，准备开找…</view><view wx:if="{{error}}" class="error">{{error}}<button class="link" bindtap="home">返回活动</button><button wx:if="{{state}}" class="link" bindtap="submit">重新提交结果</button></view>
 <block wx:if="{{state && !loading}}">
  <view class="game-top"><view><text class="scene-title">{{theme}}</text><text class="tiny muted">{{withFriend?'和朋友同一关 · 玩完揭晓合拍结果':'对比上下两张图，点击不一样的地方'}}</text></view><view class="timer {{time<=10?'urgent':''}}"><text>{{time}}</text><text class="tiny">秒</text></view></view>
  <view class="progress-row"><text>已找到 {{foundCount}} / 5</text><view class="found-dots"><text wx:for="{{dots}}" wx:key="id" class="dot {{item.done?'done':''}}">{{item.done?'✓':'·'}}</text></view><text class="tiny muted">提示 {{state.hints}} / 3</text></view>
  <view class="scene"><image src="{{imageA}}" class="scene-image" mode="aspectFit"/><text class="scene-badge">原图</text><button wx:for="{{objects}}" wx:key="id" class="hotspot {{item.found?'found':''}}" style="{{item.style}}" data-id="{{item.id}}" bindtap="tap" aria-label="原图 {{item.label}}" disabled="{{busy || aiBusy || state.status!=='playing'}}"><text wx:if="{{item.found}}" class="found-tick">✓</text></button></view>
  <view class="scene second"><image src="{{imageB}}" class="scene-image" mode="aspectFit"/><text class="scene-badge">找不同</text><view wx:if="{{hintRegion}}" class="vision-region {{hintRegion}}"></view><button wx:for="{{objects}}" wx:key="id" class="hotspot {{item.found?'found':''}}" style="{{item.style}}" data-id="{{item.id}}" bindtap="tap" aria-label="找不同 {{item.label}}" disabled="{{busy || aiBusy || state.status!=='playing'}}"><text wx:if="{{item.found}}" class="found-tick">✓</text></button></view>
  <view class="feedback" aria-live="polite">{{feedback || '两张图都可以点 · 点错扣 5 分'}}</view>
  <view wx:if="{{hint}}" class="ai-clue">✦ {{hint}}</view>
  <view class="game-actions"><button class="ai-button" bindtap="hint" loading="{{aiBusy}}" disabled="{{busy || aiBusy || state.status!=='playing'}}">✦ AI 帮我找 <text class="tiny">−15 分</text></button><button class="end-button" bindtap="finish" disabled="{{busy || aiBusy || state.status!=='playing'}}">揭晓结果</button></view>
  <view wx:if="{{busy}}" class="loading">正在生成本局结果…</view>
 </block>
</view>