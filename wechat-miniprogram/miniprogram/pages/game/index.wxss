.game-page{padding:18rpx 22rpx 32rpx}.game-top{display:flex;justify-content:space-between;align-items:center;gap:10rpx;margin-bottom:18rpx}.game-top>view:first-child{display:flex;flex-direction:column}.scene-title{font-size:32rpx;font-weight:700;color:#594777}.timer{display:flex;align-items:baseline;gap:5rpx;background:#f0eaff;padding:4rpx 18rpx;border-radius:24rpx;color:#8a64cb;flex:none}.timer>text:first-child{font-size:45rpx;font-weight:750;line-height:1.4}.timer.urgent{background:#ffe6ed;color:#ca718b}.progress-row{display:flex;justify-content:space-between;align-items:center;margin:12rpx 4rpx 20rpx;font-size:24rpx;color:#7c689c}.found-dots{display:flex;gap:8rpx}.dot{display:flex;align-items:center;justify-content:center;width:28rpx;height:28rpx;border-radius:50%;background:#e9e1f4;color:#ae96cb;font-size:22rpx}.dot.done{background:#af9bd5;color:#fff}.scene{position:relative;width:100%;aspect-ratio:5/3;height:424rpx;border-radius:28rpx;overflow:hidden;border:2rpx solid #fff;box-shadow:0 5rpx 15rpx #a28bb51a}.scene-image{width:100%;height:100%;display:block}.scene.second{margin-top:16rpx}.scene-badge{position:absolute;top:10rpx;right:12rpx;padding:2rpx 10rpx;background:#ffffffd9;color:#9989ac;border-radius:10rpx;font-size:18rpx;pointer-events:none}.hotspot{position:absolute;padding:0;margin:0;border-radius:50%;background:transparent!important;border:3rpx solid transparent;min-height:0!important;overflow:visible}.hotspot::after{display:none}.hotspot.found{border-color:#a17ad6;box-shadow:0 0 0 5rpx #ffffff8f}.hotspot[disabled]{opacity:1!important}.found-tick{position:absolute;right:0;bottom:0;background:#a17ad6;color:#fff;width:28rpx;height:28rpx;line-height:28rpx;border-radius:50%;font-size:20rpx}.vision-region{position:absolute;left:0;width:100%;height:33.333%;background:#ffeaa738;border:3rpx dashed #dab45e;pointer-events:none}.vision-region.top{top:0}.vision-region.middle{top:33.333%}.vision-region.bottom{top:66.666%}.feedback{font-size:22rpx;color:#9c89b2;text-align:center;margin:12rpx 0;min-height:32rpx}.ai-clue{background:#fff4d9;color:#9e8146;border-radius:18rpx;padding:16rpx 22rpx;font-size:24rpx;margin:8rpx 0 14rpx}.game-actions{display:flex;gap:14rpx}.ai-button{flex:1;background:#e9e0fc;color:#8b68bb;min-height:88rpx;font-weight:650}.ai-button .tiny{margin-left:10rpx;font-weight:400}.end-button{background:#fff;color:#aa98bd;border:1rpx solid #ece5f4;min-height:88rpx;font-size:24rpx}