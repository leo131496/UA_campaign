.game-page{padding:24rpx}.dashboard{background:#19365d;color:#fff;border-radius:24rpx;padding:26rpx}.round{font-size:28rpx;font-weight:700}.actions{color:#b5c8e3;font-size:22rpx}.hud{display:flex;align-items:center;justify-content:space-between;margin:24rpx 0}.hud-label{display:block;color:#b5c8e3;font-size:22rpx}.hud-value{font-size:54rpx;font-weight:700;display:block;line-height:1.5}.hud-unit{font-size:24rpx;font-weight:400;color:#a9bfdc;margin-left:6rpx}.risk-high{color:#ffad87}.goal{display:flex;flex-direction:column;border-left:1rpx solid #496283;padding-left:24rpx;color:#c2d2e7;font-size:22rpx}.event{display:flex;gap:12rpx;border-top:1rpx solid #405a7e;padding-top:18rpx;font-size:23rpx;color:#c5d7ed}.event-dot{flex:none;color:#ffac8c;font-weight:800}.board-title{display:flex;justify-content:space-between;align-items:center;margin:28rpx 4rpx 18rpx;font-weight:600}.modules{display:flex;gap:12rpx}.module{position:relative;flex:1;min-width:0;padding:22rpx 12rpx;border:2rpx solid #d5e2f1;border-radius:20rpx;text-align:left;background:#fff}.module-no{color:#9aacc4;font-size:24rpx;font-weight:700}.module-name{display:block;margin:10rpx 0;font-size:26rpx;font-weight:700}.module-state{font-size:20rpx;color:#7794b8}.meter{height:10rpx;background:#e8eef7;border-radius:5rpx;margin:20rpx 0 10rpx;overflow:hidden}.fill{height:100%;background:#789ed1;transition:width .25s}.progress{font-size:36rpx;font-weight:650}.blocked{border-color:#f6a07b;background:#fff8f2}.blocked .module-state{color:#b16b45}.complete{background:#eff8f2;border-color:#a3cbb5}.complete .fill{background:#609a79}.deck{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}.resource{padding:18rpx 14rpx;border:2rpx solid #dce5f1;border-radius:18rpx;text-align:left;min-height:157rpx}.card-mark{font-size:29rpx;color:#668ac0;line-height:1}.cost{font-size:20rpx;color:#93a5bf}.resource-name{display:block;font-size:25rpx;font-weight:600;margin-top:18rpx}.resource-short{display:block;font-size:19rpx;color:#7e92ad;margin-top:8rpx}.selected{border-color:#ff956e;background:#fff0e7;box-shadow:0 0 0 2rpx #ff956e22}.unaffordable{opacity:.55}.selection{margin-top:18rpx;padding:20rpx 24rpx;border-radius:16rpx;background:#fff0e7;color:#966448;font-size:23rpx}.selection .h3{font-size:24rpx;margin-bottom:6rpx}.ai-hint{background:#e8f0fc;padding:22rpx;border-radius:16rpx;color:#5278af;font-size:24rpx;margin-top:20rpx}.timeline{margin-top:28rpx;padding-left:12rpx;border-left:3rpx solid #dde7f4}.log{display:flex;flex-direction:column;font-size:22rpx;color:#889db7;margin:14rpx 0}.log-label{color:#627c9e;font-weight:500}
