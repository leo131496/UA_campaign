.result-hero{background:#f1ecff;border-radius:36rpx;text-align:center;padding:32rpx 28rpx}.result-icon{display:block;font-size:72rpx;color:#b29be2;line-height:1.2}.result-title{font-size:52rpx;font-weight:800;display:block;color:#76559e;line-height:1.3;margin:12rpx 0 20rpx}.score-line{display:flex;justify-content:center;gap:10rpx;align-items:baseline;color:#a186c6;margin-top:14rpx}.score-line>text:first-child{font-size:64rpx;font-weight:700}.score-line>text:last-child{font-size:24rpx}.result-meta{display:flex;justify-content:center;gap:40rpx;color:#9f8db7;font-size:22rpx}.match-card{background:#fff7d9;border-radius:30rpx;padding:30rpx;margin-top:24rpx;color:#a48b4f}.match-title{font-size:32rpx;font-weight:700;color:#8c7548;display:block}.match-percent{font-size:86rpx;font-weight:800;display:block;line-height:1.4;color:#a88f50}.match-percent text{font-size:36rpx}.match-card .copy{font-size:26rpx}.match-card .muted{display:block;margin-top:18rpx;color:#b4a179}.find-tags{display:flex;gap:14rpx;margin:20rpx 0}.find-tags text{background:#fffaf0;border:1rpx solid #eee0b8;border-radius:18rpx;padding:8rpx 20rpx;font-size:24rpx;color:#a58a4b}.ai-recap{display:flex;flex-direction:column;gap:10rpx;padding:28rpx 10rpx;color:#987bb6}.ai-recap>.small{color:#a595b3}.ai-recap .link{min-height:60rpx;padding:8rpx 0;color:#9470bc}.gift-row{display:flex;gap:16rpx;align-items:center;justify-content:space-between;border-top:1rpx solid #e9e2f0;padding-top:24rpx}.gift-row>view{display:flex;flex-direction:column;gap:10rpx}.gift-row .h3{font-size:26rpx}.gift-row .small{font-size:21rpx}.gift-button{flex:none;background:#f8e9f0;color:#b8829a;font-size:24rpx;padding:22rpx 20rpx}