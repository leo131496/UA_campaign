.invite-card{background:#19365d;border-radius:28rpx;color:#fff;padding:38rpx;margin-bottom:28rpx}.invite-kicker{font-size:24rpx;color:#c5d4e9;letter-spacing:3rpx}.invite-title{display:block;font-size:64rpx;font-weight:750;line-height:1.3;margin-top:24rpx}.invite-score{display:flex;align-items:center;gap:28rpx;margin:16rpx 0}.invite-score>text{font-size:140rpx;font-weight:800;color:#ff9a76;line-height:1.3}.invite-score>view{font-size:30rpx;color:#c1d0e6}.invite-copy{font-size:24rpx;color:#b8cce7}.invite-footer{border-top:1rpx solid #486386;margin-top:30rpx;padding-top:24rpx;font-size:21rpx;color:#9fb8da}
