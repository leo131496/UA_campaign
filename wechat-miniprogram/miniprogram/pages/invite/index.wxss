.invite-card{background:#eee7fd;border-radius:36rpx;padding:32rpx 26rpx;color:#8f76af;margin-bottom:26rpx}.invite-kicker{font-size:23rpx}.invite-title{font-size:43rpx;line-height:1.5;font-weight:750;color:#70538f;display:block;margin:20rpx 0 24rpx;white-space:pre-line}.invite-picture{width:100%;height:340rpx;border-radius:24rpx;display:block}.invite-score{display:flex;align-items:center;gap:26rpx;margin:24rpx 10rpx}.invite-score>text:first-child{font-size:96rpx;font-weight:800;line-height:1.1;color:#b298d7}.invite-score>text:last-child{font-size:25rpx;white-space:pre-line}.invite-footer{font-size:20rpx;color:#a18bb9;display:block;border-top:1rpx solid #dcd0ef;padding-top:22rpx}.invite-how{display:flex;align-items:center;flex-direction:column;gap:6rpx;margin:30rpx 0;font-size:24rpx;color:#ac9bbe}