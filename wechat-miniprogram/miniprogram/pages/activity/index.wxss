.hero{position:relative;background:#eee9ff;border-radius:40rpx;padding:34rpx 24rpx 26rpx;margin:28rpx 0;overflow:hidden}.hero-sticker{display:inline-block;background:#fff3a7;color:#766132;padding:8rpx 20rpx;border-radius:22rpx;font-size:24rpx;transform:rotate(-4deg)}.hero-title{display:block;font-size:76rpx;color:#4b397d;font-weight:800;letter-spacing:3rpx;margin-top:18rpx;line-height:1.3}.hero-copy{display:block;color:#84729f;font-size:28rpx;margin-top:12rpx}.cover-wrap{position:relative;margin-top:26rpx}.cover{width:100%;height:344rpx;display:block;border-radius:28rpx}.cover-circle{position:absolute;width:72rpx;height:72rpx;border:5rpx solid #ff799b;border-radius:50%;left:8%;top:34%;transform:rotate(-12deg)}.cover-tip{position:absolute;bottom:16rpx;right:12rpx;background:#fff;padding:10rpx 18rpx;border-radius:18rpx;color:#8c689e;font-size:22rpx;box-shadow:0 4rpx 12rpx #8e75c922}.hero-tags{display:flex;justify-content:space-around;margin-top:22rpx;color:#83709c;font-size:22rpx}.under-button{display:block;text-align:center;margin:18rpx 0 30rpx;color:#8c80a0;font-size:22rpx}.how-to{display:flex;flex-direction:column;gap:18rpx;padding:0 12rpx;margin-bottom:26rpx}.how-to>view{display:flex;align-items:center;gap:16rpx;font-size:26rpx;color:#766789}.step{display:flex;align-items:center;justify-content:center;width:40rpx;height:40rpx;border-radius:50%;background:#e9e1ff;color:#8a6bb4;font-size:24rpx;font-weight:700}.ai-entry{display:flex;flex-direction:column;gap:10rpx;align-items:flex-start;background:#fff6d9;border-radius:24rpx;color:#7b663a;padding:28rpx;width:100%;font-weight:600}.ai-entry .small{font-weight:400;color:#9a8758}.friend-note{display:flex;flex-direction:column;gap:8rpx;background:#fceaf1;color:#b86a87;padding:24rpx;border-radius:24rpx;margin-top:22rpx}.friend-note .small{color:#a47d93}