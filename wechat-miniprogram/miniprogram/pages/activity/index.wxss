.hero{margin:26rpx 0;background:#19365d;border-radius:28rpx;padding:32rpx 26rpx;color:#fff;overflow:hidden}.hero-top{display:flex;align-items:center;justify-content:space-between}.eyebrow{font-size:22rpx;letter-spacing:5rpx;color:#a4b8d4}.badge{background:#385578;color:#dbe9ff;font-size:21rpx;border-radius:8rpx;padding:5rpx 12rpx}.hero-title{display:block;font-size:70rpx;font-weight:800;letter-spacing:4rpx;margin-top:30rpx;line-height:1.3}.hero-copy{display:block;font-size:25rpx;color:#becfe6;margin-top:12rpx}.map{display:flex;position:relative;justify-content:space-between;margin:42rpx 0 30rpx}.map-line{position:absolute;top:33rpx;left:50rpx;right:50rpx;height:2rpx;background:#526e91}.station{z-index:1;text-align:center;display:flex;align-items:center;flex-direction:column;font-size:24rpx;width:33%}.station-icon{display:flex;align-items:center;justify-content:center;width:68rpx;height:68rpx;border:2rpx solid #6e91bd;background:#23456f;border-radius:18rpx;font-size:36rpx;margin-bottom:16rpx}.blocked .station-icon{color:#19365d;background:#ff9772;border-color:#ff9772;font-weight:800}.station-sub{font-size:19rpx;color:#9bb0cf;margin-top:5rpx}.hero-foot{display:flex;justify-content:space-around;border-top:1rpx solid #40597a;padding-top:22rpx;font-size:22rpx;color:#c2d0e4}.under-button{font-size:22rpx;color:#8091a8;text-align:center;display:block;margin-top:18rpx}.gift-mark{font-size:40rpx;color:#ee815d}
