page{background:#faf8fd;color:#5b4b70;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.65}view,text,button,input{box-sizing:border-box}button{font-size:28rpx;line-height:1.4;margin:0;padding:24rpx 28rpx;border-radius:16rpx;color:#5b4b70;background:#fff}button::after{border:0}button[disabled]{opacity:.45;color:#8191a8}.page{padding:30rpx 30rpx 50rpx}.demo-strip{background:#fff2e6;color:#ad7548;padding:14rpx 24rpx;font-size:22rpx;border-bottom:1rpx solid #f5dfc9}.card{background:#fff;border:1rpx solid #e4eaf2;border-radius:24rpx;padding:30rpx;margin-bottom:24rpx}.title{font-size:42rpx;font-weight:700;line-height:1.4;display:block}.h2{font-size:32rpx;font-weight:650;display:block}.h3{font-size:28rpx;font-weight:600;display:block}.muted{color:#a08eaf}.small{font-size:24rpx}.tiny{font-size:22rpx}.copy{line-height:1.9;margin-top:16rpx;display:block}.primary{background:#b79ae7;color:#493460;font-weight:650;min-height:92rpx}.secondary{background:#ede5fa;color:#8c6eaf;min-height:88rpx}.ghost{background:#fff;border:1rpx solid #d9e3f1;color:#677f9f;min-height:88rpx}.danger{color:#bc5a3f}.full{width:100%}.mt{margin-top:24rpx}.mb{margin-bottom:24rpx}.row{display:flex;align-items:center;gap:18rpx}.between{justify-content:space-between}.pill{display:inline-block;padding:6rpx 14rpx;border-radius:10rpx;font-size:22rpx;color:#9577b5;background:#efe7fc}.pill.green{background:#e9f6ef;color:#37775d}.empty{padding:70rpx 30rpx;text-align:center;color:#8f9db1}.error{background:#fff0e9;border:1rpx solid #f4d6c8;color:#a86b4d;border-radius:16rpx;padding:22rpx;margin-bottom:22rpx;font-size:24rpx}.check{display:flex;align-items:flex-start;gap:14rpx;margin:26rpx 0;font-size:24rpx;color:#5e728c}.check checkbox{transform:scale(.85);transform-origin:left top;flex:none;margin-top:4rpx}.divider{height:1rpx;background:#e9eef5;margin:24rpx 0}.footer-note{font-size:22rpx;line-height:1.9;color:#95a2b5;margin-top:24rpx}.sticky{position:sticky;bottom:0;background:#faf8fdf5;padding:18rpx 0 calc(18rpx + env(safe-area-inset-bottom))}.chips{display:flex;flex-wrap:wrap;gap:14rpx;margin:24rpx 0}.chip{font-size:26rpx;padding:20rpx 24rpx;border:1rpx solid #dce6f4;border-radius:14rpx;background:#fff;color:#7a90ae}.chip.active{border-color:#78a2d7;background:#edf4ff;color:#3d6ca6}.stat-grid{display:flex;gap:14rpx}.stat-box{flex:1;min-width:0;background:#f1f6fd;padding:24rpx 12rpx;border-radius:16rpx;text-align:center}.stat-box .value{font-size:44rpx;font-weight:650;display:block;color:#4e719f}.stat-box .label{font-size:22rpx;color:#8ca0bb;display:block}.safe-copy{word-break:break-all}.loading{padding:70rpx;text-align:center;color:#9aa7ba}.button-row{display:flex;gap:16rpx}.button-row button{flex:1;font-size:26rpx;padding:24rpx 10rpx}.brand{font-size:24rpx;color:#8b9eb9;display:block}.status{font-size:24rpx;color:#59876e}.link{min-height:88rpx;color:#4c70a0;font-size:24rpx;padding:18rpx 0;background:transparent;text-align:left}.screen-reader-label{font-size:24rpx}
